# ----------------------------------------------------------------------------
# ERP Consultant Academy — environment variables
# Copy to .env.local (development) or set in your hosting platform.
# Never commit real values. Never expose secrets to the browser (no NEXT_PUBLIC_ prefix).
# ----------------------------------------------------------------------------

# Database
# Leave DATABASE_URL empty to use the embedded PGlite database (PostgreSQL in WASM)
# stored in PGLITE_DIR — ideal for local development and demos.
# Set it to a real PostgreSQL connection string for shared/production environments.
DATABASE_URL=
# DATABASE_URL=postgres://academy:CHANGE_ME@localhost:5432/erp_academy
DATABASE_POOL_MAX=10
PGLITE_DIR=.data/pglite

# Seeded accounts. Required in production; development falls back to documented demo passwords.
SEED_ADMIN_EMAIL=admin@academy.test
SEED_ADMIN_PASSWORD=
SEED_TRAINER_EMAIL=trainer@academy.test
SEED_TRAINER_PASSWORD=
SEED_STUDENT_EMAIL=student@academy.test
SEED_STUDENT_PASSWORD=

# Authentication
# Set to "false" to require trainers/admins to create trainee accounts.
ALLOW_SELF_REGISTRATION=true
# Session cookies are Secure in production. Only set false for plain-HTTP intranet trials.
# COOKIE_SECURE=true

# Private file storage for assignment submissions (outside /public).
STORAGE_DIR=storage

# AI learning assistant (server-side only). Without a key the assistant runs in
# offline mode and returns the most relevant portal passages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Days to keep assistant conversations before automatic deletion.
AI_RETENTION_DAYS=30
