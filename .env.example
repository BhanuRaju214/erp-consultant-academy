# ----------------------------------------------------------------------------
# ERP Consultant Academy — environment variables
# Copy to .env.local (development) or set in your hosting platform.
# Never commit real values. Never expose secrets to the browser (no NEXT_PUBLIC_ prefix).
# ----------------------------------------------------------------------------

# Database
# Leave DATABASE_URL empty to use the embedded PGlite database (PostgreSQL in WASM)
# stored in PGLITE_DIR — ideal for local development and demos.
# Set it to a real PostgreSQL connection string for shared/production environments.
DATABASE_URL=
# DATABASE_URL=postgres://academy:CHANGE_ME@localhost:5432/erp_academy
DATABASE_POOL_MAX=10
PGLITE_DIR=.data/pglite

# Seeded accounts. Required in production; development falls back to documented demo passwords.
SEED_ADMIN_EMAIL=admin@academy.test
SEED_ADMIN_PASSWORD=
SEED_TRAINER_EMAIL=trainer@academy.test
SEED_TRAINER_PASSWORD=
SEED_STUDENT_EMAIL=student@academy.test
SEED_STUDENT_PASSWORD=

# Authentication
# Set to "false" to require trainers/admins to create trainee accounts.
ALLOW_SELF_REGISTRATION=true
# Session cookies are Secure in production. Only set false for plain-HTTP intranet trials.
# COOKIE_SECURE=true
# Public base URL, used in password-reset emails and the Google redirect URI.
# Required in production (e.g. https://academy.example.com); inferred from the request in development.
APP_URL=

# Google sign-in (optional). Create an OAuth client ("Web application") in Google Cloud Console
# and add <APP_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (password reset). Without a key, development prints emails to the server console.
RESEND_API_KEY=
EMAIL_FROM="nexusEPM Academy <no-reply@your-domain.com>"

# File storage (media library + assignment submissions).
# Cloudflare R2: create a bucket and an R2 API token (Object Read & Write) in the Cloudflare dashboard.
# Without these, files are stored on local disk under STORAGE_DIR (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain connected to the bucket (e.g. https://media.your-domain.com), used for public assets.
R2_PUBLIC_URL=
# Set to true after `npm run media:upload-visuals` so /visuals/* images are served from R2 (needs a rebuild).
VISUALS_ON_R2=false
# The bucket needs a CORS rule so browsers can upload directly:
#   AllowedOrigins: [<APP_URL>], AllowedMethods: [PUT, GET, HEAD], AllowedHeaders: [Content-Type]
STORAGE_DIR=storage

# Mux video (optional; without it videos are stored as plain files).
# API access token (Settings → Access Tokens, Mux Video read/write):
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key for signed playback (Settings → Signing Keys); paste the base64 private key as given.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Webhook (Settings → Webhooks) pointing to <APP_URL>/api/webhooks/mux:
MUX_WEBHOOK_SECRET=

# AI learning assistant (server-side only). Without a key the assistant runs in
# offline mode and returns the most relevant portal passages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Days to keep assistant conversations before automatic deletion.
AI_RETENTION_DAYS=30

# Razorpay payments (dashboard.razorpay.com → Account & Settings → API Keys).
# Use rzp_test_… keys while testing; switch to live keys after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → <APP_URL>/api/webhooks/razorpay with events payment.captured,
# order.paid, payment.failed and refund.processed; paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# GST invoice details (prices are inclusive of 18% GST).
GST_LEGAL_NAME=
GST_GSTIN=
# Use \n for line breaks in the address.
GST_ADDRESS=
# Your state's GST code, e.g. 36 for Telangana, 29 for Karnataka, 27 for Maharashtra.
GST_STATE_CODE=
# Services accounting code on invoices; confirm with your accountant.
GST_SAC=999293
INVOICE_PREFIX=NXS

# AI course builder (uses OPENAI_API_KEY above). Optional: a different model for writing courses.
OPENAI_COURSE_MODEL=
